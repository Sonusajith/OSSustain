# Local PostgreSQL connection (Docker Compose)
POSTGRES_DB=ossustain
POSTGRES_USER=ossustain
POSTGRES_PASSWORD=ossustain-local
POSTGRES_PORT=5432

# Pipeline connection. Override when running outside the Compose network.
OSSUSTAIN_DATABASE_URL=postgresql://ossustain:ossustain-local@localhost:5432/ossustain
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ossustain

# Frontend development server
VITE_API_BASE_URL=http://localhost:8080/api/v1
