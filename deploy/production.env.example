# Copy to deploy/.env.production and replace every placeholder before deployment.
POSTGRES_DB=ossustain
POSTGRES_USER=ossustain
POSTGRES_PASSWORD=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:8088
FRONTEND_URL=http://localhost:8088
OSSUSTAIN_ANALYSIS_IP_HASH_SECRET=replace-with-a-separate-random-secret
GITHUB_TOKEN=replace-with-a-public-repositories-read-token
OSSUSTAIN_HASH_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
MODEL_ARTIFACTS_DIR=/absolute/path/to/pipeline/artifacts
HTTP_PORT=8088
BACKUP_DIR=./backups
BACKUP_FILE=
RESTORE_DATABASE=
